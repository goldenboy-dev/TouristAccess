# Staging. Copy to .env on the staging host and fill in the CHANGE_ME values.
# Full docs for every variable: see .env.example.
#
# NODE_ENV=production is intentional here, not a typo: this app only codes
# two security postures (dev vs. prod-hardened — see validateProductionSecurity
# in src/utils/env.js). Staging should run with the SAME hardening as
# production (HTTPS enforced, strict CORS, mandatory seed passwords) so it
# actually catches what production would catch — it just points at staging's
# own database and domain instead of the real ones.

NODE_ENV="production"
PORT=3000

DATABASE_URL="postgresql://tourist_access:CHANGE_ME@staging-db-host:5432/tourist_access_staging?schema=public"

# Generate with: openssl rand -base64 48 — MUST differ per environment and
# from each other, and MUST differ from production's secrets.
JWT_SECRET="CHANGE_ME_min_32_chars"
JWT_REFRESH_SECRET="CHANGE_ME_min_32_chars_different_from_jwt_secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

ADULT_PRICE=10000

ALLOWED_ORIGINS="https://staging.tourist-access.example.com"

# Required in production posture. Leave FORCE_HTTPS unset (defaults to on) or
# "true". Only "false" if TLS terminates upstream — set TRUST_PROXY then.
FORCE_HTTPS=
TRUST_PROXY=1

PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_AGE_DAYS=90
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Required (production posture) — seed refuses to run without these.
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_CASHIER1_PASSWORD=CHANGE_ME
SEED_CASHIER2_PASSWORD=CHANGE_ME
SEED_GUARD_PASSWORD=CHANGE_ME
SEED_FORCE_ROTATE=

LOG_LEVEL="info"

ALERT_FREE_PP_CRITICAL=20
ALERT_FREE_PP_WARNING=10
ALERT_FREE_PCT_LIMIT=25
HISTORY_DAYS=30
