generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String   @default("")
  password  String
  role      String   @default("CASHIER")
  createdAt DateTime @default(now())

  // ── Password policy ──
  password_changed_at  DateTime @default(now())
  must_change_password Boolean  @default(false)

  // ── Brute-force lockout ──
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?

  createdTickets Ticket[]
  guardedTickets Ticket[]       @relation("TicketGuard")
  scans          Scan[]
  groupSummaries GroupSummary[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
}

// Persisted audit trail for critical actions (emission, validation,
// cancellation, auth events). Append-only: never updated or deleted by
// the application.
model AuditLog {
  id            Int      @id @default(autoincrement())
  event         String
  actor_id      Int?
  actor         User?    @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  actor_email   String?
  actor_role    String?
  resource_type String?
  resource_id   String?
  outcome       String   @default("SUCCESS") // SUCCESS | FAILURE
  ip_address    String?
  user_agent    String?
  request_id    String?
  metadata      String? // JSON-encoded extra context
  created_at    DateTime @default(now())

  @@index([event])
  @@index([actor_id])
  @@index([created_at])
  @@index([resource_type, resource_id])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token_hash String   @unique
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ip_address String?
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([token_hash])
}

model Ticket {
  id             Int      @id @default(autoincrement())
  token          String   @unique
  customer_name  String
  visitor_type   String   // ADULT | CHILD | LOCAL
  group_id       String?
  price          Int
  visit_date     DateTime
  status         String   @default("ACTIVE")
  payment_method String   @default("CASH")

  cedula         String?
  guard_id       Int?
  guard          User?    @relation("TicketGuard", fields: [guard_id], references: [id])
  free_confirmed    String?
  free_confirmed_at DateTime?

  group_summary_id Int?
  groupSummary     GroupSummary? @relation(fields: [group_summary_id], references: [id])

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scans Scan[]

  @@index([token])
  @@index([visit_date])
  @@index([status])
  @@index([group_id])
  @@index([visitor_type])
  @@index([createdById])
}

model GroupSummary {
  id              Int      @id @default(autoincrement())
  operation_code  String   @unique
  cajero_id       Int
  cajero          User     @relation(fields: [cajero_id], references: [id])
  total_adults    Int
  total_children  Int
  total_locals    Int
  total_persons   Int
  total_amount    Int
  payment_method  String
  visit_date      DateTime
  createdAt       DateTime @default(now())

  tickets         Ticket[]

  @@index([operation_code])
  @@index([cajero_id])
  @@index([visit_date])
}

model Scan {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  guardId   Int
  guard     User     @relation(fields: [guardId], references: [id])
  scannedAt DateTime @default(now())
}
