# Master reference: every variable the app reads, with full docs.
# For a ready-to-copy starting point per deployment target, use:
#   .env.development.example | .env.staging.example | .env.production.example
# (those only call out the values that actually change between environments —
# come back here for what each one means.)

# ─── Required ─────────────────────────────────────────────
# PostgreSQL connection URL. Same engine in every environment (dev/staging/prod)
# — see docker-compose.yml for local dev, and .env.*.example for per-environment
# templates.
DATABASE_URL=postgresql://tourist_access:CHANGE_ME@localhost:5432/tourist_access_dev?schema=public

# JWT secrets (min 32 chars each, MUST be different)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-different

# Price in guaraníes for adult tickets
ADULT_PRICE=10000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ─── Security / HTTPS ─────────────────────────────────────
# Redirect HTTP -> HTTPS. Defaults to ON when NODE_ENV=production.
# Set to "false" ONLY if TLS is terminated upstream and HTTP never reaches
# this process (validateEnv rejects FORCE_HTTPS=false in production).
FORCE_HTTPS=

# Number of trusted proxy hops (or an express "trust proxy" expression).
# REQUIRED behind nginx / a load balancer: without it req.secure is always
# false (redirect loop) and req.ip becomes the proxy IP, which would make the
# login rate limiter throttle every user as if they were one client.
# Typical single reverse proxy: TRUST_PROXY=1. Leave empty in local dev.
TRUST_PROXY=

# ─── Password policy ──────────────────────────────────────
# Minimum length (default: 10). Composition rules (upper/lower/digit/symbol)
# and the common-password blocklist are always enforced.
PASSWORD_MIN_LENGTH=10

# Days before a password expires and rotation is forced. 0 disables expiry.
PASSWORD_MAX_AGE_DAYS=90

# Failed logins before the account locks, and lockout duration.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ─── Seed credentials ─────────────────────────────────────
# Passwords for the seeded users. Must satisfy the password policy.
# In development, leaving these empty generates random compliant passwords,
# printed once. In production they are REQUIRED (the seed refuses to run).
# All seeded accounts must change their password on first login.
SEED_ADMIN_PASSWORD=
SEED_CASHIER1_PASSWORD=
SEED_CASHIER2_PASSWORD=
SEED_GUARD_PASSWORD=

# Set to "true" to flag pre-existing seeded accounts for password rotation
# (needed once: the original demo passwords are in this repo's git history).
SEED_FORCE_ROTATE=

# ─── Optional ─────────────────────────────────────────────
# Server port (default: 3000)
PORT=3000

# JWT token expiry (default: 15m for access, 7d for refresh)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# Node environment: development | production
NODE_ENV=development

# Directory where the printable-ticket HTML is written. Leave EMPTY (the
# default) to keep it in memory only: the QR and every field already travel in
# the API response, and the frontend renders and prints its own copy — the
# files are just an artifact for demos, debugging or a print daemon.
# If you set it, point it at a mounted volume (see docker-compose.yml).
TICKETS_HTML_DIR=

# ─── Impresora térmica (ESC/POS por red, puerto 9100 "raw") ─────────
# Apagado por defecto: nadie tiene que configurar una impresora para levantar
# el sistema. POST /api/tickets/:id/print-thermal responde 503 mientras esté
# en false o falte PRINTER_IP.
THERMAL_PRINTING_ENABLED=false
PRINTER_IP=
PRINTER_PORT=9100
# Caracteres por línea con fuente A: ~48 en papel de 80mm, ~32 en 58mm.
PRINTER_WIDTH=48
PRINTER_TIMEOUT_MS=5000

# ─── Anti-Fraud Thresholds ────────────────────────────────
# Percentage points above historical average to trigger alerts
ALERT_FREE_PP_CRITICAL=20
ALERT_FREE_PP_WARNING=10

# Max percentage of free entries before flagging (for evolution chart)
ALERT_FREE_PCT_LIMIT=25

# Number of historical days to compare against
HISTORY_DAYS=30
