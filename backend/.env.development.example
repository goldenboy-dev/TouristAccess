# Local development. Copy to .env and adjust as needed.
# Full docs for every variable: see .env.example.
# Matches docker-compose.yml's "postgres" service when running via Docker;
# swap host/port/credentials if you're using a native local Postgres instead.

NODE_ENV="development"
PORT=3000

DATABASE_URL="postgresql://tourist_access:tourist_access_dev_pw@localhost:5432/tourist_access_dev?schema=public"

JWT_SECRET="dev-only-secret-min-32-characters-long-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-min-32-chars-different"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

ADULT_PRICE=10000

# Frontend served locally: Live Server / http-server (5500) or the
# docker-compose "frontend" nginx service (8080) — include whichever you use.
ALLOWED_ORIGINS="http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080"

# No TLS locally — HTTPS enforcement stays off and there's no proxy to trust.
FORCE_HTTPS=
TRUST_PROXY=

PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_AGE_DAYS=90
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Empty = auto-generate compliant passwords for seeded users, printed once.
SEED_ADMIN_PASSWORD=
SEED_CASHIER1_PASSWORD=
SEED_CASHIER2_PASSWORD=
SEED_GUARD_PASSWORD=
SEED_FORCE_ROTATE=

LOG_LEVEL="debug"

ALERT_FREE_PP_CRITICAL=20
ALERT_FREE_PP_WARNING=10
ALERT_FREE_PCT_LIMIT=25
HISTORY_DAYS=30
