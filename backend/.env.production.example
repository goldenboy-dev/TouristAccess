# Production. Copy to .env on the production host and fill in the CHANGE_ME
# values. Full docs for every variable: see .env.example.
# validateEnv() (src/utils/env.js) will refuse to boot if this is misconfigured
# (weak/reused JWT secrets, FORCE_HTTPS=false, wildcard/http ALLOWED_ORIGINS).

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://tourist_access:CHANGE_ME@prod-db-host:5432/tourist_access?schema=public

# Generate with: openssl rand -base64 48 — MUST differ from staging/dev and
# from each other. Store these in your secrets manager, not in a plain file.
JWT_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_different_from_jwt_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

ADULT_PRICE=10000

ALLOWED_ORIGINS=https://tourist-access.example.com

# Must stay enforced in production. Leave FORCE_HTTPS unset (defaults to on).
# TRUST_PROXY is required behind the reverse proxy/load balancer that
# terminates TLS — without it req.secure is always false (redirect loop) and
# the login rate limiter throttles by the proxy's IP instead of the client's.
FORCE_HTTPS=
TRUST_PROXY=1

PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_AGE_DAYS=90
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Required — seed refuses to run without these. Set once, then rotate via the
# app (accounts are flagged must_change_password on creation).
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_CASHIER1_PASSWORD=CHANGE_ME
SEED_CASHIER2_PASSWORD=CHANGE_ME
SEED_GUARD_PASSWORD=CHANGE_ME
SEED_FORCE_ROTATE=

LOG_LEVEL=info

ALERT_FREE_PP_CRITICAL=20
ALERT_FREE_PP_WARNING=10
ALERT_FREE_PCT_LIMIT=25
HISTORY_DAYS=30
