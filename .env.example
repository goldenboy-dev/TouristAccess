# Variables read by docker-compose.yml itself (docker compose auto-loads a
# ".env" file next to the compose file). Copy to .env and fill in.
# App-level config (JWT secrets, CORS, etc.) lives in backend/.env — see
# backend/.env.example and backend/.env.*.example.

POSTGRES_USER=tourist_access
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tourist_access
